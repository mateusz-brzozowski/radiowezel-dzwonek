{
  "rules": {
    "devices": {
      "$deviceId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "audit": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$pushId": {
        ".validate": "newData.hasChildren(['deviceId', 'commandId', 'at'])"
      }
    }
  }
}
